---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('noticias', { sort: { publishedAt: 'desc' } });

const title = "Noticias - Portal VMOS & Sierra Grande";
const description = "Listado completo de noticias del sector energético VMOS, Punta Colorada, Sierra Grande, Playas Doradas y Río Negro.";
---

<Layout title={title} description={description}>
  <header class="bg-primary text-white py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Noticias</h1>
      <p class="text-xl text-gray-200 max-w-3xl">
        Todas las noticias del sector energético de la región.
      </p>
    </div>
  </header>

  <section class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allNews.map((noticia) => (
        <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-accent text-white text-xs font-semibold rounded-full">
                {noticia.data.category}
              </span>
              <span class="px-3 py-1 bg-secondary text-white text-xs font-semibold rounded-full">
                {noticia.data.scope}
              </span>
            </div>
            <h3 class="text-xl font-bold mb-3 line-clamp-2">
              <a href={`/noticias/${noticia.slug}`} class="hover:text-accent transition-colors">
                {noticia.data.title}
              </a>
            </h3>
            <p class="text-muted mb-4 line-clamp-3">
              {noticia.data.summary}
            </p>
            <div class="flex justify-between items-center text-sm text-muted">
              <span>{new Date(noticia.data.publishedAt).toLocaleDateString('es-ES')}</span>
              <a href={`/noticias/${noticia.slug}`} class="text-accent font-semibold hover:underline">
                Leer más →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>