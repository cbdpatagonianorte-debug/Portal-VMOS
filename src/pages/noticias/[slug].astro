---
/**
 * src/pages/noticias/[slug].astro
 * Vista de detalle de artículo — diseño Faro Energético / Noticias VMOS
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

interface Props {
  noticia: CollectionEntry<'noticias'>;
}

const { noticia } = Astro.props;
const { Content } = await noticia.render();

const {
  title,
  description,
  category,
  scope,
  publishedAt,
  updatedAt,
  author,
  section,
  tag,
  readingMinutes,
  coverImage,
  image,
  isBreaking,
  kpis,
  sources,
  tags,
  metaDescription,
  isReport,
} = noticia.data;

const cover = coverImage ?? (image ? { url: image, alt: title, credit: undefined } : undefined);

// Formato de fecha legible en español
const fechaPublicacion = new Date(publishedAt).toLocaleDateString('es-AR', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const fechaActualizacion = updatedAt
  ? new Date(updatedAt).toLocaleDateString('es-AR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const seoDescription = metaDescription ?? description;
const pageTitle = `${title} — Faro Energético / Noticias VMOS`;

// Color del badge de categoría
const categoryColorMap: Record<string, string> = {
  'Punta Colorada & VMOS': 'bg-[#D97706] text-white',
  'Economía & Energía':    'bg-[#D97706] text-white',
  'Sierra Grande':         'bg-primary text-on-primary',
  'Playas Doradas':        'bg-primary text-on-primary',
  'Río Negro':             'bg-primary text-on-primary',
  'Medio Ambiente':        'bg-emerald-700 text-white',
  'Logística':             'bg-primary text-on-primary',
  'Legislación':           'bg-primary text-on-primary',
  'Empleo Técnico':        'bg-primary text-on-primary',
  'Comunidad':             'bg-primary text-on-primary',
};
const badgeClass = categoryColorMap[category] ?? 'bg-primary text-on-primary';
---

<!DOCTYPE html>
<html lang="es" class="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={seoDescription} />
  {tags && <meta name="keywords" content={tags.join(', ')} />}

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap"
    rel="stylesheet"
  />
  <!-- Material Symbols -->
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet"
  />

  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-block;
      vertical-align: middle;
      line-height: 1;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: 0.4; transform: scale(1.15); }
    }
    .live-pulse { animation: pulse-dot 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite; }

    .prose pre,
    article pre,
    pre {
      background-color: #f8fafc !important; /* slate-50 */
      color: #0f172a !important; /* slate-900 */
      border: 1px solid #e2e8f0 !important;
      border-radius: 0.5rem !important;
    }

    .prose pre code,
    article pre code,
    pre code {
      background-color: transparent !important;
      color: #0f172a !important;
    }
  </style>
  <style>
    @media print {
      header, footer, .no-print { display: none !important; }
      main { max-width: 100% !important; padding: 0 !important; }
      .print-hero-img { max-height: 400px; }
      body { background: white; color: black; }
      .prose a { color: black; text-decoration: underline; }
      .bg-primary { background-color: white !important; color: black !important; }
      .border-outline-variant { border-color: #ccc !important; }
      .bg-surface, .bg-surface-container, .bg-surface-container-low, .bg-surface-container-lowest { background-color: white !important; }
    }
  </style>
</head>

<body class="bg-background text-on-surface font-sans antialiased min-h-screen flex flex-col">

  <Header activeSection={
    category === 'Sierra Grande'          ? 'sierra-grande'   :
    category === 'Playas Doradas'         ? 'playas-doradas'  :
    category === 'Río Negro'              ? 'rio-negro'        :
    category === 'Economía & Energía'     ? 'economia-energia' :
    'punta-colorada'
  } />

  <main class="flex-grow w-full">

    <!-- ────────────────────────────────────────────────── -->
    <!-- CABECERA DEL ARTÍCULO                              -->
    <!-- ────────────────────────────────────────────────── -->
    <div class="max-w-[860px] mx-auto px-4 lg:px-8 pt-12 pb-6">

      <!-- Supertítulo de sección -->
      <div class="flex items-center gap-2 mb-4 font-sans text-xs text-outline">
        {tag && <span class="font-bold text-[#D97706] tracking-wide uppercase">{tag}</span>}
        {tag && <span>•</span>}
        {section && <span class="uppercase">{section}</span>}
        {section && <span>•</span>}
        <span class="uppercase">{scope}</span>
        {readingMinutes && (
          <>
            <span>•</span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-xs">timer</span>
              {readingMinutes} min de lectura
            </span>
          </>
        )}
      </div>

      <!-- Título principal -->
      <h1 class="font-sans text-3xl md:text-4xl font-bold text-primary leading-tight tracking-tight uppercase mb-6">
        {title}
      </h1>

      <!-- Bajada / descripción -->
      <p class="font-sans text-gray-600 font-normal text-lg leading-relaxed mb-4">
        {description}
      </p>

      {isReport && (
        <div class="mb-6">
          <button
            onclick="window.print()"
            class="inline-flex items-center gap-2 bg-primary text-on-primary font-sans text-sm font-bold px-5 py-2.5 rounded-lg hover:bg-secondary transition-colors shadow-sm"
            aria-label="Descargar nota en PDF"
            type="button"
          >
            <span class="material-symbols-outlined text-base">download</span>
            Descargar PDF
          </button>
        </div>
      )}

      <!-- Byline + fecha -->
      <div class="flex flex-wrap items-center justify-between gap-y-2 py-4 border-y border-outline-variant/60">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-secondary-container text-on-secondary-fixed font-bold flex items-center justify-center text-sm">
            FE
          </div>
          <div>
            <p class="font-sans text-sm font-semibold text-primary">{author}</p>
            <p class="font-sans text-xs text-outline">{fechaPublicacion}</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          {fechaActualizacion && (
            <div class="flex items-center gap-1 text-outline font-sans text-xs">
              <span class="material-symbols-outlined text-xs">update</span>
              <span>Actualizado: {fechaActualizacion}</span>
            </div>
          )}
          <!-- Acciones de artículo -->
          <div class="flex items-center gap-2">
            <button aria-label="Compartir artículo" class="p-2 text-outline hover:text-primary rounded hover:bg-surface-container transition-colors" type="button">
              <span class="material-symbols-outlined text-base">share</span>
            </button>
            <button aria-label="Guardar artículo" class="p-2 text-outline hover:text-primary rounded hover:bg-surface-container transition-colors" type="button">
              <span class="material-symbols-outlined text-base">bookmark_border</span>
            </button>
            <button aria-label="Imprimir artículo" class="p-2 text-outline hover:text-primary rounded hover:bg-surface-container transition-colors hidden sm:flex" type="button">
              <span class="material-symbols-outlined text-base">print</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ────────────────────────────────────────────────── -->
    <!-- IMAGEN DE PORTADA (Recorte Editorial Nítido)       -->
    <!-- ────────────────────────────────────────────────── -->
    {cover && (
      <div class="px-4 lg:px-8 w-full max-w-7xl mx-auto mb-12 mt-4">
        <div class="w-full overflow-hidden rounded-xl shadow-lg relative group bg-surface-container">
          <img
            src={cover.url}
            alt={cover.alt}
            width={1920}
            height={1080}
            class="w-full h-[400px] md:h-[500px] object-cover object-center transition-transform duration-700 group-hover:scale-[1.02]"
            loading="eager"
          />
          {/* Crédito fotográfico */}
          {cover.credit && (
            <div class="absolute bottom-4 right-4 bg-surface/90 backdrop-blur-sm px-3 py-1.5 rounded text-on-surface font-label-caption text-[11px] shadow-sm flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[12px]">photo_camera</span>
              {cover.credit}
            </div>
          )}
          {/* Badges Flotantes sobre la imagen */}
          <div class="absolute top-4 left-4 flex flex-wrap items-center gap-2 z-10">
            <span class={`font-label-ticker text-xs font-bold px-3 py-1.5 tracking-wider uppercase rounded shadow ${badgeClass}`}>
              {category}
            </span>
            {isBreaking && (
              <span class="bg-error text-white font-label-ticker text-xs font-bold px-3 py-1.5 tracking-wider uppercase rounded shadow flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-white live-pulse"></span>
                ÚLTIMO MOMENTO
              </span>
            )}
          </div>
        </div>
      </div>
    )}

    <!-- ────────────────────────────────────────────────── -->
    <!-- CUERPO Y BLOQUES OPERATIVOS                        -->
    <!-- ────────────────────────────────────────────────── -->
    <div class="max-w-[860px] mx-auto px-4 lg:px-8 pb-12 space-y-10">

      <!-- KPIs (si los tiene) -->
      {kpis && kpis.length > 0 && (
        <div class="bg-surface-container-low border border-outline-variant/60 rounded-xl p-6 grid grid-cols-2 md:grid-cols-4 gap-6 shadow-sm">
          {kpis.map((kpi, i) => (
            <div class="flex flex-col gap-2">
              <div class={`w-10 h-10 flex items-center justify-center rounded-full ${i % 2 === 0 ? 'bg-primary text-on-primary' : 'bg-secondary text-on-secondary'}`}>
                <span class="material-symbols-outlined text-xl">{kpi.icon}</span>
              </div>
              <div>
                <span class="block font-label-caption text-[11px] text-outline uppercase tracking-wider mb-1">{kpi.label}</span>
                <span class="font-sans font-bold text-sm text-primary">{kpi.value}</span>
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- Contenido del Artículo (Prose) -->
      <div class="max-w-3xl mx-auto text-justify font-sans prose prose-lg prose-pre:bg-slate-50 prose-pre:text-slate-900 prose-headings:font-sans prose-headings:font-bold prose-h2:text-primary prose-h2:font-bold prose-h2:border-b-2 prose-h2:border-outline-variant prose-h2:pb-2 prose-h2:mt-12 prose-h3:text-secondary prose-h3:mt-8 prose-p:font-sans prose-p:font-normal prose-p:text-on-surface-variant prose-p:leading-relaxed prose-a:text-[#D97706] hover:prose-a:text-secondary prose-li:font-sans prose-li:font-normal prose-li:text-on-surface-variant prose-blockquote:border-l-4 prose-blockquote:border-[#D97706] prose-blockquote:bg-surface-container-low prose-blockquote:px-6 prose-blockquote:py-4 prose-blockquote:rounded-r prose-blockquote:text-on-surface prose-strong:text-on-surface prose-img:rounded-xl prose-img:shadow-md">
        <Content />
      </div>

      <!-- ─── TAGS ─── -->
      {tags && tags.length > 0 && (
        <div class="max-w-3xl mx-auto pt-8 border-t border-outline-variant/60">
          <span class="font-label-ticker text-xs text-outline uppercase tracking-wider mr-3">Temas de interés:</span>
          <div class="inline-flex flex-wrap gap-2 mt-3">
            {tags.map((t) => (
              <span class="bg-surface-container hover:bg-surface-container-high cursor-pointer transition-colors border border-outline-variant font-label-caption text-label-caption text-on-surface-variant px-3 py-1.5 rounded">
                #{t}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- ─── FUENTES ─── -->
      <div class="max-w-3xl mx-auto pt-8 border-t border-outline-variant/60">
        <h2 class="font-label-ticker text-sm text-outline uppercase tracking-wider mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-base">menu_book</span>
          Fuentes Periodísticas
        </h2>
        <ul class="flex flex-col gap-2">
          {sources.map((src) => (
            <li class="font-sans text-sm text-on-surface flex items-start gap-2 bg-surface-container-lowest p-3 rounded border border-outline-variant/40">
              <span class="material-symbols-outlined text-secondary text-sm mt-0.5 shrink-0">verified</span>
              <span>{src}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- ─── NAVEGACIÓN CONTEXTUAL ─── -->
      <div class="max-w-3xl mx-auto mt-4 pt-8 border-t-2 border-primary flex items-center justify-between">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-secondary hover:text-primary font-label-ticker text-sm font-bold transition-colors group"
        >
          <span class="material-symbols-outlined text-sm group-hover:-translate-x-1 transition-transform">arrow_back</span>
          <span>Volver a la Portada</span>
        </a>
      </div>

    </div>
  </main>

  <!-- ─── FOOTER COMPACTO ─── -->
  <footer class="w-full py-8 px-6 border-t border-outline-variant/60 bg-primary text-on-primary">
    <div class="max-w-[1440px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="font-sans font-bold text-sm uppercase tracking-wider">FARO ENERGÉTICO / NOTICIAS VMOS</span>
      <p class="font-label-caption text-label-caption text-primary-fixed-dim text-center sm:text-right">
        © 2025 Faro Energético. Todos los derechos reservados. ISSN 2953-481X
      </p>
    </div>
  </footer>

</body>
</html>