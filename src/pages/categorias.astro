---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('noticias', { sort: { publishedAt: 'desc' } });

// Agrupar por categoría
const categories = {
  'VMOS_Energia': allNews.filter(n => n.data.category === 'VMOS_Energia'),
  'Sierra_Grande': allNews.filter(n => n.data.category === 'Sierra_Grande'),
  'Playas_Doradas': allNews.filter(n => n.data.category === 'Playas_Doradas'),
  'Rio_Negro': allNews.filter(n => n.data.category === 'Rio_Negro'),
  'Nacional_Internacional': allNews.filter(n => n.data.category === 'Nacional_Internacional'),
};

const title = "Categorías - Portal VMOS & Sierra Grande";
const description = "Explora las noticias por categorías: VMOS Energía, Sierra Grande, Playas Doradas, Río Negro y Nacional/Internacional.";
---

<Layout title={title} description={description}>
  <header class="bg-primary text-white py-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Categorías</h1>
      <p class="text-xl text-gray-200 max-w-3xl">
        Noticias clasificadas por temática y alcance geográfico.
      </p>
    </div>
  </header>

  <section class="container mx-auto px-4 py-12">
    {Object.entries(categories).map(([category, noticias]) => (
      noticias.length > 0 && (
        <section class="mb-16">
          <h2 class="text-2xl font-bold mb-6 text-dark flex items-center gap-3">
            <span class="px-3 py-1 bg-accent text-white text-sm font-semibold rounded-full">
              {category}
            </span>
            {category.replace('_', ' ')}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {noticias.map((noticia) => (
              <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <div class="p-6">
                  <span class="px-3 py-1 bg-secondary text-white text-xs font-semibold rounded-full">
                    {noticia.data.scope}
                  </span>
                  <h3 class="text-xl font-bold mb-3 mt-2 line-clamp-2">
                    <a href={`/noticias/${noticia.slug}`} class="hover:text-accent transition-colors">
                      {noticia.data.title}
                    </a>
                  </h3>
                  <p class="text-muted mb-4 line-clamp-3">
                    {noticia.data.summary}
                  </p>
                  <div class="flex justify-between items-center text-sm text-muted">
                    <span>{new Date(noticia.data.publishedAt).toLocaleDateString('es-ES')}</span>
                    <a href={`/noticias/${noticia.slug}`} class="text-accent font-semibold hover:underline">
                      Leer más →
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    ))}
  </section>
</Layout>