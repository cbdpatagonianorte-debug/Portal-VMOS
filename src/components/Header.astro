---
/**
 * Header.astro — Cabecera del portal Faro Energético / Noticias VMOS
 * Incluye: barra utilitaria superior, banner publicitario y navbar sticky con logo SVG inline.
 */

interface Props {
  activeSection?: string;
}

const { activeSection = 'punta-colorada' } = Astro.props;

import BannerHeaderPublicidad from './BannerHeaderPublicidad.astro';

const navLinks = [
  { href: '/categoria/punta-colorada-y-vmos', label: 'Punta Colorada & VMOS' },
  { href: '/categoria/sierra-grande',         label: 'Sierra Grande' },
  { href: '/categoria/playas-doradas',        label: 'Playas Doradas' },
  { href: '/categoria/rio-negro',             label: 'Río Negro' },
  { href: '/categoria/economia-y-energia',    label: 'Economía & Energía' },
];
---

<!-- =========================================================== -->
<!-- 1. BARRA UTILITARIA SUPERIOR: datos meteo + ticker energía   -->
<!-- =========================================================== -->
<aside class="w-full bg-primary text-on-primary border-b border-outline-variant/30 text-xs py-1.5 px-4 lg:px-8">
  <div class="max-w-[1440px] mx-auto flex flex-wrap items-center justify-between gap-y-2 gap-x-4">

    <!-- Señales meteorológicas y mareas -->
    <div class="flex flex-wrap items-center gap-x-6 gap-y-1 font-label-caption text-label-caption text-primary-fixed-dim">
      <div class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-secondary-container text-sm">schedule</span>
        <span class="text-on-primary font-medium">
          {new Date().toLocaleDateString('es-AR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
      </div>
      <div class="hidden sm:flex items-center gap-1.5">
        <span class="material-symbols-outlined text-secondary-container text-sm">air</span>
        <span>Sierra Grande: <strong class="text-on-primary font-semibold">22°C</strong> (SO 34 km/h)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-secondary-fixed text-sm">water</span>
        <span>
          Playas Doradas:
          <span class="text-on-primary">Pleamar 14:35 hs</span>
          •
          <span class="text-on-primary">Bajamar 20:50 hs</span>
        </span>
      </div>
    </div>

    <!-- Ticker BRENT + selector región -->
    <div class="flex items-center gap-x-4 font-label-caption text-label-caption ml-auto">
      <div class="flex items-center gap-1.5 bg-primary-container px-2.5 py-0.5 rounded border border-outline-variant/40">
        <span class="font-bold text-on-primary tracking-wide">BRENT OIL</span>
        <span class="text-secondary-fixed font-semibold">$74.80</span>
        <span class="text-emerald-400 font-bold flex items-center">
          <span class="material-symbols-outlined text-xs">arrow_drop_up</span>+1.4%
        </span>
      </div>
      <div class="hidden md:flex items-center gap-1 text-on-primary cursor-pointer hover:text-secondary-fixed transition-colors">
        <span class="material-symbols-outlined text-sm">near_me</span>
        <span class="font-medium">Golfo San Matías</span>
        <span class="material-symbols-outlined text-xs">expand_more</span>
      </div>
    </div>

  </div>
</aside>

<!-- =========================================================== -->
<!-- 2. BANNER PUBLICITARIO (espacio disponible)                 -->
<!-- =========================================================== -->
<div class="w-full bg-surface-container-low border-b border-outline-variant/40 py-2.5 px-4">
  <BannerHeaderPublicidad />
</div>

<!-- =========================================================== -->
<!-- 3. NAVBAR PRINCIPAL (sticky)                                  -->
<!-- =========================================================== -->
<header class="w-full bg-surface border-b border-outline-variant sticky top-0 z-40">
  <div class="max-w-[1440px] mx-auto px-4 lg:px-8">

    <!-- Logo + acciones -->
    <div class="flex items-center justify-between py-3.5 border-b border-outline-variant/30 gap-4">

      <!-- Logo SVG inline (Stitch screen 6629bba0) -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 60" width="200" height="40" fill="none" aria-label="Logo Faro Energético / Noticias VMOS">
          <rect width="60" height="60" rx="8" fill="#0A2540"/>
          <!-- Faro + rayo de energía -->
          <path d="M22 46L26 22H34L38 46H22Z" fill="#CBDBF5"/>
          <rect x="25" y="16" width="10" height="6" rx="2" fill="#D97706"/>
          <circle cx="30" cy="13" r="3" fill="#FFE082"/>
          <path d="M14 18L5 15M46 18L55 15M14 26L4 27M46 26L56 27" stroke="#D97706" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 26L28 34H33L29 44" stroke="#0A2540" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Tipografía -->
          <text x="72" y="26" font-family="'Oswald', sans-serif" font-weight="800" font-size="20" fill="#0A2540" letter-spacing="0.5">FARO ENERGÉTICO</text>
          <text x="72" y="44" font-family="'Oswald', sans-serif" font-weight="700" font-size="12" fill="#D97706" letter-spacing="2">NOTICIAS VMOS</text>
          <rect x="180" y="32" width="6" height="6" rx="3" fill="#E11D48"/>
          <text x="194" y="43" font-family="sans-serif" font-weight="600" font-size="10" fill="#64748B" letter-spacing="1">PATAGONIA &amp; GOLFO</text>
        </svg>
      </a>

      <!-- Acciones de utilidad -->
      <div class="flex items-center gap-2 md:gap-3">
        <button
          data-search-toggle
          aria-label="Buscar noticias e informes"
          class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded transition-colors flex items-center justify-center"
          type="button"
        >
          <span class="material-symbols-outlined text-xl">search</span>
        </button>

        <button
          data-notifications-toggle
          aria-label="Alertas del Golfo"
          class="relative p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded transition-colors hidden sm:flex items-center justify-center"
          type="button"
        >
          <span class="material-symbols-outlined text-xl">notifications</span>
          <span data-notif-badge class="absolute top-1.5 right-1.5 w-2 h-2 bg-error rounded-full ring-2 ring-surface"></span>
        </button>

        <button
          data-theme-toggle
          aria-label="Cambiar modo oscuro"
          class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded transition-colors hidden md:flex items-center justify-center"
          type="button"
        >
          <span class="material-symbols-outlined text-xl theme-icon">wb_sunny</span>
        </button>

        <div class="h-6 w-px bg-outline-variant hidden sm:block"></div>

        <button
          class="hidden md:inline-flex items-center px-3 py-1.5 text-xs font-label-ticker text-primary border border-primary hover:bg-surface-container rounded transition-colors font-medium"
          type="button"
        >
          Boletín VMOS
        </button>

        <button
          data-newsletter-subscribe
          class="inline-flex items-center px-4 py-1.5 bg-primary hover:bg-primary-container text-on-primary font-label-ticker text-xs font-medium rounded transition-colors shadow-sm"
          type="button"
        >
          Suscribirse
        </button>

        <!-- Avatar corresponsal -->
        <div class="relative pl-1">
          <div
            class="w-8 h-8 rounded-full bg-primary-container border border-outline-variant flex items-center justify-center text-primary-fixed text-xs font-bold"
            title="Avatar de usuario corresponsal"
          >
            CR
          </div>
        </div>
      </div>
    </div>

    <!-- Navegación de secciones -->
    <nav aria-label="Navegación principal" class="hidden md:flex items-center justify-start gap-8 py-2.5 overflow-x-auto text-sm font-label-ticker">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={
            Astro.url.pathname === href || activeSection === href.replace('/categoria/', '')
              ? 'text-secondary border-b-2 border-secondary pb-1 font-semibold whitespace-nowrap'
              : 'text-on-surface-variant hover:text-primary transition-colors pb-1 whitespace-nowrap'
          }
        >
          {label}
        </a>
      ))}
    </nav>

  </div>
</header>
