---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="es" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Merriweather:wght@300;400;700&display=swap" rel="stylesheet" />
  <link rel="icon" href="/favicon.ico" />
  <!-- Client-side app -->
  <script type="module" src="/scripts/app.js"></script>
</head>
<body class="bg-background text-on-surface font-sans antialiased">
  <main class="min-h-screen">
    <slot />
  </main>
  <footer class="bg-dark text-white py-8 mt-12">
    <div class="container mx-auto px-4 text-center">
      <p class="text-sm text-gray-400">
        Portal Informativo VMOS & Sierra Grande © 2024
      </p>
    </div>
  </footer>

  <!-- Modales globales -->
  <div id="search-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-black/50 backdrop-blur-sm">
    <div class="relative w-full max-w-lg p-4 md:p-6 bg-surface rounded-xl shadow-2xl">
      <div class="flex justify-between items-start mb-4">
        <h2 class="text-xl font-bold text-primary">Buscar noticias</h2>
        <button id="search-close" class="p-2 text-gray-400 hover:text-primary">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <input
        id="search-input"
        type="text"
        placeholder="Buscar por título, categoría o contenido..."
        class="w-full px-4 py-3 mb-4 bg-surface-container-lowest border border-outline-variant rounded text-primary focus:outline-none focus:ring-2 focus:ring-secondary"
      />
      <div id="search-results" class="max-h-[400px] overflow-y-auto space-y-2 hidden"></div>
    </div>
  </div>

  <div id="notifications-dropdown" class="fixed top-16 right-4 z-50 w-64 bg-surface rounded-xl shadow-2xl border border-outline-variant hidden">
    <!-- Contenido se llena dinámicamente por JS -->
  </div>

  <div id="newsletter-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-black/50 backdrop-blur-sm">
    <div class="relative w-full max-w-md p-4 md:p-6 bg-surface rounded-xl shadow-2xl">
      <div class="flex justify-between items-start mb-4">
        <h2 class="text-xl font-bold text-primary">Boletín VMOS</h2>
        <button onclick="closeNewsletterModal()" class="p-2 text-gray-400 hover:text-primary">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <p class="mb-4 text-gray-600">Reciba actualizaciones semanales sobre la industria energética y desarrollos regionales.</p>
      <form class="space-y-4">
        <input
          data-newsletter-email
          type="email"
          placeholder="Su correo corporativo..."
          class="w-full px-4 py-3 bg-surface-container-lowest border border-outline-variant rounded text-primary focus:outline-none focus:ring-2 focus:ring-secondary"
          required
        />
        <button
          type="submit"
          class="w-full bg-primary hover:bg-primary-container text-on-primary font-label-ticker text-xs font-bold uppercase tracking-wider rounded transition-colors py-3"
        >
          Suscribirse
        </button>
      </form>
    </div>
  </div>
</body>
</html>